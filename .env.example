# Models
# Any provider below works by name (groq:openai/gpt-oss-120b,
# openrouter:openai/gpt-oss-120b, litellm:<model>) or as a registered Model row.
MAIN_MODEL=ollama:llama3.1:8b
EMBEDDING_MODEL=openai:text-embedding-3-small
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# LITELLM_URL=http://localhost:4000   # OpenAI-compatible LiteLLM proxy
# LITELLM_API_KEY=                    # master key, if the proxy requires one

# Search
TAVILY_API_KEY=

# Persistence
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# NMB_DATABASE_URL=             # wins over DATABASE_URL (registry DB; Aegra keeps DATABASE_URL for its own store)
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/nmb_marketplace_agent

# Shared rate limits across workers (optional; needs the `redis` package)
# REDIS_URL=redis://localhost:6379/0

# RAG
VECTOR_STORE_ROOT=data/indexes
RAG_DEFAULT_TOP_K=4

# Async subagents (optional remote server URL)
ASYNC_RESEARCHER_URL=

# LangGraph runtime URL (used by dashboard run proxy)
LANGGRAPH_URL=http://127.0.0.1:2024

# Portal/admin API token
ADMIN_TOKEN=

# Auth: tenant JWTs and short-lived chat session tokens (both >= 32 chars)
NMB_JWT_SECRET=
# NMB_SESSION_SECRET=            # overrides NMB_JWT_SECRET for session tokens
# NMB_SESSION_TTL=900            # seconds, clamped to 60..3600

# One-click demo sign-in on the login page. Unset: auto-on unless LICENSE_ENFORCE
# is on or ENV=production; set to false to hide it anywhere.
# DEMO_ACCOUNTS=true
# DEMO_TENANT=default            # tenant persona tokens are minted for

# Public chat output screening over SSE: guarded (default) | buffered
# CHAT_OUTPUT_STREAMING=guarded

# Comma-separated front-end origins; restrict in production
# CORS_ORIGINS=https://app.example.com

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Encryption at rest for PII columns (handoff text/reason, notification bodies).
# Generate a key: python -m nmb_marketplace_agent.crypto generate
# Then seal existing rows: python -m nmb_marketplace_agent.crypto reencrypt
# NMB_ENCRYPTION_KEY=
# NMB_ENCRYPTION_KEY_FILE=        # key file (wins over NMB_ENCRYPTION_KEY)
# NMB_ENCRYPTION_KEYS_OLD=        # comma-separated, decrypt-only during rotation
# NMB_ENCRYPTION_REQUIRED=true    # fail closed if no key is configured
# LangGraph checkpoint blobs (Aegra Postgres) use the same key. Seal existing
# threads with: python -m nmb_marketplace_agent.checkpoint_store rewrap|status
#   (--dsn postgresql://... ; defaults to DATABASE_URL or POSTGRES_*)

# Tool safety (optional)
# HTTP_TOOL_ALLOWED_HOSTS=api.example.com,other.example.com
# HTTP_TOOL_ALLOW_PRIVATE=0
# PYTHON_TOOL_PREFIXES=nmb_marketplace_agent.custom_tools.

# Citations: days to keep per-run source rows
# CITATION_RETENTION_DAYS=7

# Approval notifications (enterprise outbox)
# ENTERPRISE_NOTIFY=on
# NOTIFY_INTERVAL_S=15
# NOTIFY_MAX_ATTEMPTS=5
# NOTIFY_HMAC_KEY=               # falls back to AUDIT_HMAC_KEY
# NMB_APPROVALS_URL=http://localhost:5173/enterprise/approvals
# Routes can also be managed per tenant via POST /enterprise/notification-routes
# NMB_NOTIFY_ROUTES={"compliance_officer":[{"channel":"webhook","target":"https://hooks.example/approvals"}]}
# SMTP transport for email routes
# NMB_SMTP_HOST=
# NMB_SMTP_PORT=587
# NMB_SMTP_USER=
# NMB_SMTP_PASSWORD=
# NMB_SMTP_FROM=
# NMB_SMTP_STARTTLS=1

