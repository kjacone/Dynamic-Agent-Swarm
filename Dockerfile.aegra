# syntax=docker/dockerfile:1.7

# ============================================================================
# Stage 2: Aegra (production runtime — this is what docker-compose.yml's
# agent-server service builds). Open-source, self-hosted, no license key.
#
# For fast local iteration without the extra Postgres/Redis containers Aegra
# needs, use the `langgraph-dev` stage above instead.
# ============================================================================
FROM python:3.12-slim AS aegra

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_HTTP_TIMEOUT=120 \
    UV_HTTP_RETRIES=10

# --- Dependency layer (cached) ---
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

# --- Project layer ---
COPY . .
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# So `from app.registries.db import ...` etc. resolve — WORKDIR is /app, our
# package lives at /app/app/, so /app must be on the path.
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH=/app

EXPOSE 2026

CMD ["aegra", "serve", "--host", "0.0.0.0", "--port", "2026"]