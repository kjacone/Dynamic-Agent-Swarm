# Models
MAIN_MODEL=anthropic:claude-sonnet-4-5-20250929
EMBEDDING_MODEL=openai:text-embedding-3-small
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Search
TAVILY_API_KEY=

# Persistence
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/nmb_marketplace_agent

# RAG
VECTOR_STORE_ROOT=data/indexes
RAG_DEFAULT_TOP_K=4

# Async subagents (optional remote server URL)
ASYNC_RESEARCHER_URL=

# LangGraph runtime URL (used by dashboard run proxy)
LANGGRAPH_URL=http://127.0.0.1:2024

# Portal/admin API token
ADMIN_TOKEN=

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Tool safety (optional)
# HTTP_TOOL_ALLOWED_HOSTS=api.example.com,other.example.com
# HTTP_TOOL_ALLOW_PRIVATE=0
# PYTHON_TOOL_PREFIXES=nmb_marketplace_agent.custom_tools.

# Tool safety (optional)
